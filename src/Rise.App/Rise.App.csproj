<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><AssemblyName>RISE</AssemblyName><RootNamespace>Rise.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets/rise.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version><Description>An aggressively Y2K alarm clock that refuses to close until you wake up.</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Rise.Core/Rise.Core.csproj"/><PackageReference Include="NAudio.WinMM" Version="2.2.1"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../LICENSE"/><EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md"/><EmbeddedResource Include="../../licenses/*.txt"/></ItemGroup>
</Project>
