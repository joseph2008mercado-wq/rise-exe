<Window x:Class="Rise.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rise.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="RISE.EXE" Width="620" Height="630" MinWidth="500" MinHeight="560" Background="#152A3C" WindowStartupLocation="CenterScreen" Foreground="#D5E5F5" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#DFEDF7" BorderThickness="1" Margin="4" Background="{StaticResource Metal}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="21"/></Grid.RowDefinitions>
  <Border Background="{StaticResource Metal}" BorderBrush="#0A1824" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="31"/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="10,0"><TextBlock Text="▣" Foreground="#103E72" FontSize="18" VerticalAlignment="Center"/><TextBlock Text=" RISE.EXE" Foreground="#0B2033" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/></StackPanel>
    <Button Grid.Column="1" Content="_" Padding="3" Margin="1,3" Click="MinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize"/>
    <Button Grid.Column="2" Content="×" Padding="3" Margin="1,3,4,3" Click="CloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close"/>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#273E54" Margin="3,2">
  <Grid Margin="5">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <local:SkinFrame x:Name="BrandPanel" Face="{StaticResource Metal}" Padding="14,10" Margin="0,0,0,4">
    <Grid Height="51">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="RISE.EXE" FontFamily="Arial Black" FontSize="25" FontStyle="Italic" Foreground="#142D49"><TextBlock.Effect><DropShadowEffect Color="#FFFFFF" ShadowDepth="1" Direction="270" BlurRadius="0"/></TextBlock.Effect></TextBlock><TextBlock Text="ALARM CLOCK / 0.1.3" Foreground="#17334D" FontSize="8"/></StackPanel>
     <local:HardwareDial Grid.Column="1" Width="57" Height="57" VerticalAlignment="Center"/>
     <Border Grid.Column="2" Background="#042E61" BorderBrush="#0B1522" BorderThickness="2" CornerRadius="9" Padding="8,6" Margin="8,8,0,8"><TextBlock x:Name="StatusLed" Text="NO ALARMS" Foreground="#91D1FF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9"/></Border>
    </Grid>
   </local:SkinFrame>
   <local:SkinFrame x:Name="ClockPanel" Grid.Row="1" Padding="17,13" Margin="0,0,0,5">
    <local:SkinFrame.Face><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#21578E"/><GradientStop Color="#062A5D" Offset=".26"/><GradientStop Color="#041E47" Offset=".6"/><GradientStop Color="#15477C" Offset="1"/></LinearGradientBrush></local:SkinFrame.Face>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="78"/><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <local:DisplayTexture Grid.RowSpan="5" IsHitTestVisible="False" Opacity=".5"/>
     <Grid><TextBlock Text="LOCAL TIME" Foreground="#9FBFE4" FontSize="8"/><TextBlock x:Name="AmPmText" Text="AM" Foreground="#D1E8FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="DateText" Foreground="#AFCEF0" FontSize="8" HorizontalAlignment="Right"/></Grid>
     <local:DigitalClock x:Name="Clock" Grid.Row="1" Margin="3,8,3,3"><local:DigitalClock.Effect><DropShadowEffect Color="#459FFF" ShadowDepth="0" BlurRadius="5" Opacity=".4"/></local:DigitalClock.Effect></local:DigitalClock>
     <TextBlock x:Name="NextText" Grid.Row="2" Text="No alarms enabled" Foreground="#B4D7FF" FontSize="10" TextWrapping="Wrap" Margin="0,4"/>
     <local:Spectrum x:Name="Visualizer" Grid.Row="3" Margin="0,3,0,3"/>
     <Grid Grid.Row="4" Margin="0,3,0,0"><TextBlock Text="▰ ▰ ▰  AUDIO" Foreground="#75A6D4" FontSize="8"/><TextBlock Text="44.1k / BASS / LIMIT" Foreground="#9CC4EC" FontSize="8" HorizontalAlignment="Right"/></Grid>
    </Grid>
   </local:SkinFrame>
   <StackPanel x:Name="NormalPanel" Grid.Row="2">
    <local:SkinFrame x:Name="QueueToolbar" Face="{StaticResource Metal}" Padding="13,9" Margin="0,0,0,3"><Grid><TextBlock Text="ALARMS + TIMERS" Foreground="#122E48" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AddButton" Content="+ ALARM" Click="AddClick" Padding="8,5" FontSize="10"/><Button x:Name="AddTimerButton" Content="+ TIMER" Click="AddTimerClick" Padding="8,5" FontSize="10" Margin="5,0,0,0"/></StackPanel></Grid></local:SkinFrame>
    <local:SkinFrame x:Name="EmptyBox" Padding="15" Margin="0,0,0,3"><TextBlock x:Name="EmptyText" Text="Add an alarm for a time of day, or a timer for a countdown." Foreground="#AAC6E5" FontSize="10" TextWrapping="Wrap"/></local:SkinFrame>
    <ItemsControl x:Name="AlarmList"><ItemsControl.ItemTemplate><DataTemplate><local:SkinFrame Padding="13" Margin="0,0,0,3"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="51"/><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions>
     <Button Content="{Binding ToggleText}" Click="ToggleAlarm" Tag="{Binding}" Padding="3,6" FontSize="9" Margin="0,0,5,0" ToolTip="Enable an alarm, or pause and resume a timer"/>
     <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" FontSize="17" Foreground="#A3D9FF" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="5,0"><TextBlock Text="{Binding Label}" FontWeight="Bold" TextTrimming="CharacterEllipsis" FontSize="11"/><TextBlock Text="{Binding DisplayDays}" Foreground="#A1BEDB" FontSize="9" Margin="0,2,0,0"/><TextBlock Text="{Binding DisplaySound}" Foreground="#70A5D2" FontSize="8" Margin="0,2,0,0"/></StackPanel>
     <Button Grid.Column="3" Content="EDIT" Padding="4,6" Margin="0,0,4,0" Click="EditClick" Tag="{Binding}" FontSize="10"/>
     <Button Grid.Column="4" Content="×" Padding="4,6" Click="DeleteClick" Tag="{Binding}" AutomationProperties.Name="Delete alarm"/>
    </Grid></local:SkinFrame></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border x:Name="Editor" Visibility="Collapsed" BorderBrush="#B1C7DB" BorderThickness="3" Background="#0B2B4D" Padding="12" Margin="0,3,0,6">
     <StackPanel>
      <TextBlock x:Name="EditorTitle" Text="NEW ALARM" Foreground="#B7DEFF" FontWeight="Bold" Margin="0,0,0,9"/>
      <StackPanel x:Name="AlarmTimePanel">
       <TextBlock Text="TIME" Foreground="#AACBE9" FontSize="9" Margin="0,0,0,5"/>
       <StackPanel Orientation="Horizontal"><ComboBox x:Name="HourInput" Width="72" FontSize="20" SelectionChanged="EditorChanged" AutomationProperties.Name="Alarm hour"/><TextBlock Text=":" FontSize="22" VerticalAlignment="Center" Margin="5,0"/><ComboBox x:Name="MinuteInput" Width="72" FontSize="20" SelectionChanged="EditorChanged" AutomationProperties.Name="Alarm minute"/><ComboBox x:Name="PeriodInput" Width="80" FontSize="16" Margin="9,0,0,0" SelectionChanged="EditorChanged" AutomationProperties.Name="AM or PM"/></StackPanel>
       <TextBlock Text="REPEAT" Foreground="#AACBE9" FontSize="9" Margin="0,10,0,5"/>
       <ComboBox x:Name="RepeatInput" SelectionChanged="EditorChanged" AutomationProperties.Name="Alarm repeat"/>
       <UniformGrid x:Name="DayChoices" Columns="7" Margin="0,9,0,0" Visibility="Collapsed"/>
       <StackPanel x:Name="OnceOptions" Margin="0,8,0,0"><ComboBox x:Name="OnceModeInput" SelectionChanged="EditorChanged" AutomationProperties.Name="Alarm date option"/><DatePicker x:Name="OnceDate" Margin="0,7,0,0" SelectedDateChanged="EditorChanged" Visibility="Collapsed" AutomationProperties.Name="One-time alarm date"/></StackPanel>
      </StackPanel>
      <StackPanel x:Name="TimerDurationPanel" Visibility="Collapsed">
       <TextBlock Text="DURATION" Foreground="#AACBE9" FontSize="9" Margin="0,0,0,5"/>
       <StackPanel Orientation="Horizontal"><StackPanel><TextBox x:Name="TimerHoursInput" Text="0" Width="65" MaxLength="3" TextChanged="EditorChanged" AutomationProperties.Name="Timer hours"/><TextBlock Text="HOURS" Foreground="#AACBE9" FontSize="8" Margin="0,3,0,0"/></StackPanel><StackPanel Margin="10,0,0,0"><TextBox x:Name="TimerMinutesInput" Text="5" Width="65" MaxLength="2" TextChanged="EditorChanged" AutomationProperties.Name="Timer minutes"/><TextBlock Text="MINUTES" Foreground="#AACBE9" FontSize="8" Margin="0,3,0,0"/></StackPanel><StackPanel Margin="10,0,0,0"><TextBox x:Name="TimerSecondsInput" Text="0" Width="65" MaxLength="2" TextChanged="EditorChanged" AutomationProperties.Name="Timer seconds"/><TextBlock Text="SECONDS" Foreground="#AACBE9" FontSize="8" Margin="0,3,0,0"/></StackPanel></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="5 MIN" Tag="300" Click="TimerPresetClick" Padding="8,4"/><Button Content="15 MIN" Tag="900" Click="TimerPresetClick" Padding="8,4" Margin="5,0,0,0"/><Button Content="30 MIN" Tag="1800" Click="TimerPresetClick" Padding="8,4" Margin="5,0,0,0"/></StackPanel>
      </StackPanel>
      <TextBlock x:Name="EditorSummary" Foreground="#B8DFFF" TextWrapping="Wrap" FontSize="10" Margin="0,9,0,0"/>
      <TextBlock Text="LABEL (OPTIONAL)" Foreground="#AACBE9" FontSize="9" Margin="0,10,0,5"/>
      <TextBox x:Name="LabelInput" MaxLength="64" AutomationProperties.Name="Alarm or timer label"/>
      <TextBlock Text="SOUND" Foreground="#AACBE9" FontSize="9" Margin="0,10,0,0"/>
      <ComboBox x:Name="EditorSound" Margin="0,9,0,0" AutomationProperties.Name="Alarm sound"/>
      <TextBlock x:Name="EditorError" Foreground="#FF92B7" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="CANCEL" Click="CancelEditClick" Margin="0,0,5,0"/><Button x:Name="SaveEntryButton" Content="SAVE ALARM" Click="SaveClick"/></StackPanel>
     </StackPanel>
    </Border>
   </StackPanel>
   <StackPanel x:Name="PuzzlePanel" Grid.Row="2" Visibility="Collapsed">
    <local:SkinFrame Padding="15" Margin="0,0,0,5"><StackPanel>
     <TextBlock Text="COMPLETE THE MEMORY PUZZLE TO DISMISS" Foreground="#FFC4E3" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock x:Name="RingLabel" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
     <Border x:Name="WarningBox" Visibility="Collapsed" Background="#51233D" BorderBrush="#FF62B0" BorderThickness="1" Padding="8" Margin="0,8,0,0"><TextBlock Text="ESCAPE ATTEMPT DETECTED — CONSCIOUSNESS VERIFICATION REQUIRED." Foreground="#FFBDDC" FontSize="10" TextWrapping="Wrap"/></Border>
     <Grid Margin="0,11,0,8"><TextBlock x:Name="PuzzleText" Text="WATCH THE SEQUENCE" Foreground="#AED9FF" FontSize="11"/><TextBlock x:Name="RoundText" Text="5 TILES" HorizontalAlignment="Right" Foreground="#9CB7D2"/></Grid>
     <UniformGrid x:Name="Tiles" Columns="4" Height="65"/>
     <TextBlock Text="REPEAT WITH 1 2 3 4 / Q W E R / MOUSE" FontSize="9" Foreground="#A1BEDB" Margin="0,9,0,0" TextWrapping="Wrap"/>
     <Button x:Name="ReplayButton" Content="↺ REPLAY SEQUENCE" HorizontalAlignment="Left" Click="ReplayClick" Margin="0,9,0,0" Padding="9,5"/>
    </StackPanel></local:SkinFrame>
   </StackPanel>
   <local:SkinFrame x:Name="SoundPanel" Grid.Row="3" Padding="14" Margin="0,3,0,4" Face="{StaticResource Metal}">
    <StackPanel>
     <Grid Margin="0,0,0,7"><TextBlock Text="SOUND" Foreground="#112B43" FontWeight="Bold" FontSize="10"/><TextBlock Text="BASS / DRIVE / OUTPUT" HorizontalAlignment="Right" Foreground="#1D3C59" FontSize="8"/></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PreviewSound" AutomationProperties.Name="Preview sound"/><Button x:Name="PreviewButton" Grid.Column="1" Content="▶ PREVIEW" Margin="5,0,0,0" Click="PreviewClick" Padding="8,4" FontSize="10"/><Button x:Name="DemoButton" Grid.Column="2" Content="TEST ALARM" Margin="5,0,0,0" Click="DemoClick" Padding="8,4" FontSize="10"/></Grid>
     <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="63"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="VOLUME" Foreground="#102B45" VerticalAlignment="Center" FontSize="9" FontWeight="Bold"/><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0.05" ValueChanged="AudioChanged" AutomationProperties.Name="Volume"/><TextBlock x:Name="VolumeText" Grid.Column="2" Foreground="#102B45" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/><TextBlock Grid.Column="3" Text="INTENSITY" Foreground="#102B45" VerticalAlignment="Center" FontSize="9" FontWeight="Bold"/><Slider x:Name="IntensitySlider" Grid.Column="4" ValueChanged="AudioChanged" AutomationProperties.Name="Intensity"/></Grid>
    </StackPanel>
   </local:SkinFrame>
   <local:SkinFrame x:Name="WakePanel" Grid.Row="4" Padding="14" Margin="0,0,0,3"><StackPanel><CheckBox x:Name="WakeToggle" Content="WAKE WINDOWS FOR ENABLED ALARMS" Click="WakeToggleClick" FontSize="9"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="KeepAliveToggle" Content="KEEP HEADPHONES ACTIVE" Click="KeepAliveChanged" FontSize="9" VerticalAlignment="Center"/><ComboBox x:Name="KeepAliveInterval" Grid.Column="1" Width="160" FontSize="10" SelectionChanged="KeepAliveChanged" AutomationProperties.Name="Headphone keep-alive interval"/></Grid><TextBlock Text="2 seconds of silence. Keeps Windows awake; screen can turn off." Foreground="#9DB7D1" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="KeepAliveStatus" Foreground="#9DB7D1" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="DiagnosticText" Foreground="#9DB7D1" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="AudioRouteText" Text="HEADPHONE FALLBACK → SPEAKERS / 100%" Foreground="#9DB7D1" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="AudioErrorText" Foreground="#FF9CBF" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></local:SkinFrame>
  </Grid>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{StaticResource Metal}" BorderBrush="#152C41" BorderThickness="1" Padding="9,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="RISE.EXE 0.1.3" Foreground="#142D43" FontSize="8" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="LOCAL TIME / AM-PM" Foreground="#142D43" FontSize="8" FontWeight="Bold"/></Grid></Border>
 </Grid>
 </Border>
</Window>
